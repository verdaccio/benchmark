{
  "name": "verdaccio-install-benchmark",
  "version": "0.0.0",
  "private": true,
  "description": "Benchmark package installation performance across Verdaccio release tags.",
  "type": "module",
  "scripts": {
    "bench": "node scripts/bench.mjs",
    "bench:install": "node scripts/bench.mjs --scenarios warm-install,proxy-install",
    "bench:publish": "node scripts/bench.mjs --scenarios publish,unpublish",
    "bench:serve": "node scripts/bench.mjs --scenarios serve",
    "report": "node scripts/report.mjs",
    "report:compare": "node scripts/report-compare.mjs",
    "report:monorepo": "node scripts/report-monorepo.mjs",
    "report:bigpkg": "node scripts/report-bigpkg.mjs",
    "bench:compare": "scripts/compare-tmp.sh",
    "compare:v6": "scripts/compare-line.sh v6 6.0.5,6.1.6,6.2.9,6.3.2,6.4.0,6.5.2,6.6.2,6.7.4,6.8.0,6.9.2 15",
    "snapshot": "node scripts/snapshot-upstream.mjs",
    "bench:frozen": "node scripts/bench.mjs --frozen",
    "import:history": "node scripts/import-history.mjs",
    "report:history": "node scripts/report-history.mjs",
    "build:site": "node scripts/build-site.mjs",
    "docker:build": "docker compose build",
    "docker:bench": "docker compose run --rm bench scripts/bench.mjs --versions v6=latest,v7=next-7,v9=next-9,v5=latest-5",
    "docker:report": "docker compose run --rm bench scripts/report.mjs",
    "docker:bench:monorepo": "docker compose run --rm bench scripts/bench.mjs --scenarios monorepo --versions v6=latest --samples 3 --warmup 1",
    "bench:all": "scripts/bench-all.sh"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.2.2"
}
