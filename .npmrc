# npm equivalent of the pnpm minimumReleaseAge policy in pnpm-workspace.yaml.
# Refuse dependency versions published less than 7 days (10080 minutes) ago,
# except Verdaccio's own packages (this project benchmarks fresh next-* releases).
# Scope: installing THIS repo's dependencies. The benchmark's measured installs
# run in temp dirs outside the repo, so this never blocks fixture packages.
min-release-age=10080
min-release-age-exclude[]=@verdaccio/*
min-release-age-exclude[]=@verdaccio-scope/*
min-release-age-exclude[]=verdaccio-*
